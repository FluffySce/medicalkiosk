# Database
DATABASE_URL=postgresql://user:password@localhost:5432/medicalkiosk

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Azure OpenAI (for embeddings)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-01

# Clinic info (for slips)
CLINIC_NAME=Medical Kiosk Clinic
CLINIC_ADDRESS=123 Health Street
CLINIC_PHONE=+1-555-0100

# Optional: LLM timeout
TRIAGE_LLM_TIMEOUT_MS=10000